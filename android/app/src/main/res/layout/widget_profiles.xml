<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/w_bg" android:padding="10dp">
    <TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="Open SwitchMonitor to connect" android:textColor="#FFA8A8A8" android:textSize="13sp" android:visibility="gone" />
    <LinearLayout android:id="@+id/content" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
            <FrameLayout android:id="@+id/p0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp">
                <ImageView android:id="@+id/pc0" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/w_tile" android:scaleType="fitXY" android:contentDescription="@null" />
                <ImageView android:id="@+id/pr0" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/w_tile_ring" android:scaleType="fitXY" android:contentDescription="@null" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
                    <ImageView android:id="@+id/pi0" android:layout_width="22dp" android:layout_height="22dp" android:contentDescription="@null" />
                    <TextView android:id="@+id/pt0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FF141414" android:textSize="16sp" android:textStyle="bold" />
                    <TextView android:id="@+id/pn0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:ellipsize="end" android:maxLines="1" android:paddingStart="4dp" android:paddingEnd="4dp" android:textColor="#FF141414" android:textSize="11sp" android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>
            <FrameLayout android:id="@+id/p1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp">
                <ImageView android:id="@+id/pc1" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/w_tile" android:scaleType="fitXY" android:contentDescription="@null" />
                <ImageView android:id="@+id/pr1" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/w_tile_ring" android:scaleType="fitXY" android:contentDescription="@null" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
                    <ImageView android:id="@+id/pi1" android:layout_width="22dp" android:layout_height="22dp" android:contentDescription="@null" />
                    <TextView android:id="@+id/pt1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FF141414" android:textSize="16sp" android:textStyle="bold" />
                    <TextView android:id="@+id/pn1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:ellipsize="end" android:maxLines="1" android:paddingStart="4dp" android:paddingEnd="4dp" android:textColor="#FF141414" android:textSize="11sp" android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
            <FrameLayout android:id="@+id/p2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp">
                <ImageView android:id="@+id/pc2" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/w_tile" android:scaleType="fitXY" android:contentDescription="@null" />
                <ImageView android:id="@+id/pr2" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/w_tile_ring" android:scaleType="fitXY" android:contentDescription="@null" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
                    <ImageView android:id="@+id/pi2" android:layout_width="22dp" android:layout_height="22dp" android:contentDescription="@null" />
                    <TextView android:id="@+id/pt2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FF141414" android:textSize="16sp" android:textStyle="bold" />
                    <TextView android:id="@+id/pn2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:ellipsize="end" android:maxLines="1" android:paddingStart="4dp" android:paddingEnd="4dp" android:textColor="#FF141414" android:textSize="11sp" android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>
            <FrameLayout android:id="@+id/p3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp">
                <ImageView android:id="@+id/pc3" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/w_tile" android:scaleType="fitXY" android:contentDescription="@null" />
                <ImageView android:id="@+id/pr3" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/w_tile_ring" android:scaleType="fitXY" android:contentDescription="@null" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
                    <ImageView android:id="@+id/pi3" android:layout_width="22dp" android:layout_height="22dp" android:contentDescription="@null" />
                    <TextView android:id="@+id/pt3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FF141414" android:textSize="16sp" android:textStyle="bold" />
                    <TextView android:id="@+id/pn3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:ellipsize="end" android:maxLines="1" android:paddingStart="4dp" android:paddingEnd="4dp" android:textColor="#FF141414" android:textSize="11sp" android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
