<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/w_bg" android:padding="14dp">
    <TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="Open SwitchMonitor to connect" android:textColor="#FFA8A8A8" android:textSize="13sp" android:visibility="gone" />
    <LinearLayout android:id="@+id/content" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <LinearLayout android:id="@+id/name_box" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:id="@+id/kind" android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/g_monitor" android:alpha="0.8" android:contentDescription="@null" />
            <TextView android:id="@+id/name" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" android:ellipsize="end" android:maxLines="1" android:textColor="#FFC8C8C8" android:textSize="12sp" />
            <!-- The other display: the widget then shows and controls it -->
            <FrameLayout android:id="@+id/swap" android:layout_width="34dp" android:layout_height="30dp" android:layout_marginStart="4dp" android:background="@drawable/w_pill">
                <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_gravity="center" android:src="@drawable/g_swap" android:contentDescription="Other display" />
            </FrameLayout>
        </LinearLayout>
        <TextView android:id="@+id/pct" android:layout_width="wrap_content" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:textColor="#FFF2F2F2" android:textSize="38sp" android:textStyle="bold" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:orientation="horizontal">
            <FrameLayout android:id="@+id/minus" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:background="@drawable/w_pill">
                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="center" android:src="@drawable/g_minus" android:contentDescription="Darker" />
            </FrameLayout>
            <FrameLayout android:id="@+id/plus" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginStart="4dp" android:background="@drawable/w_pill_light">
                <ImageView android:id="@+id/plus_icon" android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="center" android:src="@drawable/g_plus" android:contentDescription="Brighter" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
