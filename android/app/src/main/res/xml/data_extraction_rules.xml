<?xml version="1.0" encoding="utf-8"?>
<!-- The paired computers (sealed tokens, last state) stay on this phone: a backup or a new phone pairs again. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="switchmonitor.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="switchmonitor.xml" />
    </device-transfer>
</data-extraction-rules>
