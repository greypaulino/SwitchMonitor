<Application x:Class="SwitchMonitor.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:SwitchMonitor.App"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- Tokens: neutral graphite (no blue cast). Glass surfaces are white at low opacity with a hairline of light so
             cards float over the ground; the one accent is a warm light fill with dark text (selected tab, current input,
             main action, slider fill, switches), as in the references. Text tiers keep 4.5:1 or more on the ground. -->
        <SolidColorBrush x:Key="WindowBrush" Color="#141414" />
        <LinearGradientBrush x:Key="BackdropBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#232323" Offset="0" />
            <GradientStop Color="#171717" Offset="0.5" />
            <GradientStop Color="#121212" Offset="1" />
        </LinearGradientBrush>
        <RadialGradientBrush x:Key="GlowBrush" Center="0.15,0.0" GradientOrigin="0.15,0.0" RadiusX="0.75" RadiusY="0.6">
            <GradientStop Color="#14FFFFFF" Offset="0" />
            <GradientStop Color="#00FFFFFF" Offset="1" />
        </RadialGradientBrush>
        <SolidColorBrush x:Key="PanelBrush" Color="#0AFFFFFF" />
        <SolidColorBrush x:Key="CardBrush" Color="#0EFFFFFF" />
        <SolidColorBrush x:Key="CardEdgeBrush" Color="#1EFFFFFF" />
        <SolidColorBrush x:Key="PopupBrush" Color="#262626" />
        <SolidColorBrush x:Key="RaisedBrush" Color="#16FFFFFF" />
        <SolidColorBrush x:Key="HoverBrush" Color="#26FFFFFF" />
        <SolidColorBrush x:Key="SelectedBrush" Color="#1EFFFFFF" />
        <SolidColorBrush x:Key="LineBrush" Color="#16FFFFFF" />
        <SolidColorBrush x:Key="ControlLineBrush" Color="#2AFFFFFF" />
        <SolidColorBrush x:Key="TileBrush" Color="#1FFFFFFF" />
        <SolidColorBrush x:Key="TextBrush" Color="#F7F7F7" />
        <SolidColorBrush x:Key="MutedBrush" Color="#BDBDBD" />
        <SolidColorBrush x:Key="FaintBrush" Color="#999999" />
        <!-- The one accent: a warm light fill with dark text -->
        <SolidColorBrush x:Key="PillOnBrush" Color="#F1EEE6" />
        <SolidColorBrush x:Key="PillOnTextBrush" Color="#141414" />
        <SolidColorBrush x:Key="AccentBrush" Color="#F1EEE6" />
        <SolidColorBrush x:Key="AccentOnBrush" Color="#141414" />
        <SolidColorBrush x:Key="AccentSolidBrush" Color="#F1EEE6" />
        <SolidColorBrush x:Key="AccentTextBrush" Color="#F1EEE6" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#24FFFFFF" />
        <SolidColorBrush x:Key="ErrorBrush" Color="#FF8A80" />
        <SolidColorBrush x:Key="WarningBrush" Color="#33290F" />
        <SolidColorBrush x:Key="WarningTextBrush" Color="#FFD27A" />
        <SolidColorBrush x:Key="OverlayBrush" Color="#FFFFFF" />

        <!-- Icons of the panel: font, weight and line weight of the chosen icon style (Settings; Theme sets them) -->
        <FontFamily x:Key="IconFont">Segoe MDL2 Assets</FontFamily>
        <FontWeight x:Key="IconWeight">Normal</FontWeight>
        <sys:Double x:Key="IconStroke">1.8</sys:Double>

        <!-- Motion: feedback only. Strong ease-out, 100-150 ms; nothing on screen performs an entrance. -->
        <CubicEase x:Key="Ease" EasingMode="EaseOut" />
        <Duration x:Key="Quick">0:0:0.12</Duration>

        <!-- Keyboard focus: one ring, in the accent, drawn outside the control -->
        <Style x:Key="FocusRing">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="-3" RadiusX="14" RadiusY="14" Stroke="{StaticResource AccentTextBrush}" StrokeThickness="2"
                                   SnapsToDevicePixels="True" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Text roles -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <!-- Glyph of the Windows icon font next to a title or a setting name -->
        <Style x:Key="Glyph" TargetType="TextBlock">
            <EventSetter Event="Loaded" Handler="RestyleIcon" />
            <Setter Property="FontFamily" Value="{DynamicResource IconFont}" />
            <Setter Property="FontWeight" Value="{DynamicResource IconWeight}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- Icon tile: a glyph on a small rounded glass square (settings, sections, profiles) -->
        <Style x:Key="IconTile" TargetType="Border">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{StaticResource TileBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardEdgeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- Glass card: the grouping surface of every view -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardEdgeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="24,20" />
            <Setter Property="Margin" Value="0,0,0,24" />
        </Style>
        <!-- Keycap: one key of a shortcut -->
        <Style x:Key="Keycap" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ControlLineBrush}" />
            <Setter Property="BorderThickness" Value="1,1,1,2" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="MinWidth" Value="24" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource FaintBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Figure" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Buttons. The surface carries the fill; a white overlay brightens it on hover; a press scales it to 0.97. -->
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,7" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="17"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" />
                            <Border x:Name="Overlay" Background="{StaticResource OverlayBrush}" CornerRadius="17" Opacity="0" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Overlay" Storyboard.TargetProperty="Opacity" To="0.07"
                                                             Duration="{StaticResource Quick}" EasingFunction="{StaticResource Ease}" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Overlay" Storyboard.TargetProperty="Opacity" To="0"
                                                             Duration="{StaticResource Quick}" EasingFunction="{StaticResource Ease}" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="0.97" Duration="0:0:0.1"
                                                             EasingFunction="{StaticResource Ease}" />
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="0.97" Duration="0:0:0.1"
                                                             EasingFunction="{StaticResource Ease}" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.15"
                                                             EasingFunction="{StaticResource Ease}" />
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.15"
                                                             EasingFunction="{StaticResource Ease}" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource FlatButton}" />

        <!-- The one filled action of a view (Apply, Save) -->
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource AccentOnBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinWidth" Value="84" />
        </Style>

        <!-- Secondary actions that should not compete: text only until hovered -->
        <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Padding" Value="10,7" />
        </Style>

        <!-- Actions that overwrite something (factory reset, delete) -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
        </Style>

        <!-- Options of one choice shown side by side (inputs, profiles); the current one is filled in the accent -->
        <Style x:Key="SegmentButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="MinHeight" Value="38" />
        </Style>

        <!-- Small glyph button (speaker, reset, refresh) using the Windows icon font -->
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="FontFamily" Value="{DynamicResource IconFont}" />
            <Setter Property="FontWeight" Value="{DynamicResource IconWeight}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>

        <!-- Dark drop-down -->
        <ControlTemplate x:Key="ComboToggle" TargetType="ToggleButton">
            <Border x:Name="Box" Background="{StaticResource RaisedBrush}" CornerRadius="12"
                    BorderBrush="{StaticResource ControlLineBrush}" BorderThickness="1">
                <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,11,0"
                      Data="M 0 0 L 4 4 L 8 0" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.5" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Box" Property="Background" Value="{StaticResource HoverBrush}" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentTextBrush}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Row" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="9">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="MinWidth" Value="180" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Template="{StaticResource ComboToggle}" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                            <ContentPresenter Margin="11,0,30,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="Fade">
                                <Border Background="{DynamicResource PopupBrush}" BorderBrush="{StaticResource ControlLineBrush}"
                                        BorderThickness="1" CornerRadius="14" Padding="5" Margin="0,4,8,8"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.35" />
                                    </Border.Effect>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slider: a 4 px rail, the filled part in the accent (it is the value), a round thumb that grows under the pointer -->
        <Style x:Key="SliderFill" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent">
                            <Border x:Name="Fill" Height="6" CornerRadius="3" Background="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Fill" Property="Background" Value="{StaticResource FaintBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SliderRest" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SliderThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Ellipse x:Name="Knob" Width="18" Height="18" Fill="{StaticResource TextBrush}"
                                 Stroke="#141414" StrokeThickness="3" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <ScaleTransform />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.2"
                                                             Duration="{StaticResource Quick}" EasingFunction="{StaticResource Ease}" />
                                            <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.2"
                                                             Duration="{StaticResource Quick}" EasingFunction="{StaticResource Ease}" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="RenderTransform.ScaleX" To="1"
                                                             Duration="{StaticResource Quick}" EasingFunction="{StaticResource Ease}" />
                                            <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="RenderTransform.ScaleY" To="1"
                                                             Duration="{StaticResource Quick}" EasingFunction="{StaticResource Ease}" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Knob" Property="Fill" Value="{StaticResource FaintBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="SmallChange" Value="1" />
            <Setter Property="LargeChange" Value="5" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="24" Background="Transparent">
                            <Border Height="6" CornerRadius="3" Background="{StaticResource RaisedBrush}" VerticalAlignment="Center" Margin="2,0" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderFill}" Command="Slider.DecreaseLarge" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderRest}" Command="Slider.IncreaseLarge" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SliderThumb}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <!-- Slider handles the click itself (move to point), so the focus handler must also see handled events. -->
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="FocusSlider" HandledEventsToo="True" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ControlLineBrush}" />
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Check box: a 16 px box that fills with the accent -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="16" Height="16" CornerRadius="4" Background="{StaticResource RaisedBrush}"
                                    BorderBrush="{StaticResource ControlLineBrush}" BorderThickness="1" VerticalAlignment="Center">
                                <Path x:Name="Mark" Data="M 3.5 8 L 6.5 11 L 12.5 4.5" Stroke="{StaticResource AccentOnBrush}" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource MutedBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentSolidBrush}" />
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Chip that turns something on or off (inputs visited by Next input) -->
        <Style x:Key="ChipToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chip" CornerRadius="15" Padding="11,5,13,5" Background="Transparent"
                                BorderBrush="{StaticResource ControlLineBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="Glyph" Text="&#xE710;" FontFamily="{DynamicResource IconFont}" FontWeight="{DynamicResource IconWeight}" FontSize="10"
                                           VerticalAlignment="Center" Margin="0,1,6,0" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource MutedBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{StaticResource PillOnBrush}" />
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource PillOnBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource PillOnTextBrush}" />
                                <Setter TargetName="Glyph" Property="Text" Value="&#xE73E;" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- View tabs at the top of the window -->
        <Style x:Key="TabButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Tab" Background="Transparent" Padding="16,7" CornerRadius="16" Margin="2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{TemplateBinding Tag}" FontFamily="{DynamicResource IconFont}" FontWeight="{DynamicResource IconWeight}" FontSize="13"
                                           VerticalAlignment="Center" Margin="0,1,8,0" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                <Setter TargetName="Tab" Property="Background" Value="{StaticResource RaisedBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource PillOnTextBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter TargetName="Tab" Property="Background" Value="{StaticResource PillOnBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- On/off switch for two-option controls (FreeSync); the knob slides -->
        <!-- Navigation tab whose current state is drawn by a pill that slides under it (MainWindow NavIndicator) -->
        <Style x:Key="NavTab" TargetType="RadioButton" BasedOn="{StaticResource TabButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Tab" Background="Transparent" Padding="16,7" CornerRadius="16" Margin="2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{TemplateBinding Tag}" FontFamily="{DynamicResource IconFont}" FontWeight="{DynamicResource IconWeight}" FontSize="13"
                                           VerticalAlignment="Center" Margin="0,1,8,0" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsChecked" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                <Setter TargetName="Tab" Property="Background" Value="{StaticResource RaisedBrush}" />
                            </MultiTrigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource PillOnTextBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Switch" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track" Width="44" Height="24" CornerRadius="12" Background="{StaticResource RaisedBrush}"
                                BorderBrush="{StaticResource ControlLineBrush}" BorderThickness="1">
                            <Ellipse x:Name="Knob" Width="16" Height="16" Fill="{StaticResource MutedBrush}"
                                     HorizontalAlignment="Left" Margin="3,0,0,0">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource AccentSolidBrush}" />
                                <Setter TargetName="Knob" Property="Fill" Value="{StaticResource AccentOnBrush}" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="RenderTransform.X" To="18"
                                                             Duration="0:0:0.15" EasingFunction="{StaticResource Ease}" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="RenderTransform.X" To="0"
                                                             Duration="0:0:0.15" EasingFunction="{StaticResource Ease}" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource MutedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Disclosure: a section heading that opens and closes the content under it; the chevron turns -->
        <Style x:Key="Disclosure" TargetType="Expander">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton x:Name="Header" IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Cursor="Hand" HorizontalAlignment="Left" FocusVisualStyle="{StaticResource FocusRing}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <StackPanel Orientation="Horizontal" Background="Transparent">
                                            <TextBlock x:Name="Chevron" Text="&#xE76C;" FontFamily="{DynamicResource IconFont}" FontWeight="{DynamicResource IconWeight}" FontSize="10"
                                                       Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                                                       RenderTransformOrigin="0.5,0.5" Margin="0,1,8,0">
                                                <TextBlock.RenderTransform>
                                                    <RotateTransform />
                                                </TextBlock.RenderTransform>
                                            </TextBlock>
                                            <ContentPresenter VerticalAlignment="Center" />
                                        </StackPanel>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="Chevron" Storyboard.TargetProperty="RenderTransform.Angle"
                                                                             To="90" Duration="0:0:0.15" EasingFunction="{StaticResource Ease}" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>
                                                <Trigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="Chevron" Storyboard.TargetProperty="RenderTransform.Angle"
                                                                             To="0" Duration="0:0:0.15" EasingFunction="{StaticResource Ease}" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.ExitActions>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Chevron" Property="Foreground" Value="{StaticResource TextBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                            </ToggleButton>
                            <ContentPresenter x:Name="Body" Visibility="Collapsed" Margin="0,14,0,0" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="Body" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CardDisclosure" TargetType="Expander">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <!-- The header is the card's title band; folded, the band is the whole card -->
                            <Border x:Name="Band" Background="#38000000" BorderBrush="#12FFFFFF" BorderThickness="0,0,0,1"
                                    CornerRadius="17,17,0,0" Margin="-24,-20,-24,0">
                            <ToggleButton x:Name="Header" IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Cursor="Hand" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="24,13"
                                          FocusVisualStyle="{StaticResource FocusRing}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <StackPanel Orientation="Horizontal" Background="Transparent" Margin="{TemplateBinding Padding}">
                                            <TextBlock x:Name="Chevron" Text="&#xE76C;" FontFamily="{DynamicResource IconFont}" FontWeight="{DynamicResource IconWeight}" FontSize="10"
                                                       Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                                                       RenderTransformOrigin="0.5,0.5" Margin="0,1,8,0">
                                                <TextBlock.RenderTransform>
                                                    <RotateTransform />
                                                </TextBlock.RenderTransform>
                                            </TextBlock>
                                            <ContentPresenter VerticalAlignment="Center" />
                                        </StackPanel>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="Chevron" Storyboard.TargetProperty="RenderTransform.Angle"
                                                                             To="90" Duration="0:0:0.15" EasingFunction="{StaticResource Ease}" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>
                                                <Trigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="Chevron" Storyboard.TargetProperty="RenderTransform.Angle"
                                                                             To="0" Duration="0:0:0.15" EasingFunction="{StaticResource Ease}" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.ExitActions>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Chevron" Property="Foreground" Value="{StaticResource TextBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                            </ToggleButton>
                            </Border>
                            <ContentPresenter x:Name="Body" Visibility="Collapsed" Margin="0,20,0,0" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="Body" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="Band" Property="CornerRadius" Value="17" />
                                <Setter TargetName="Band" Property="BorderThickness" Value="0" />
                                <Setter TargetName="Band" Property="Margin" Value="-24,-20,-24,-20" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Menus: dark, floating (the one place a shadow belongs) -->
        <Style TargetType="ContextMenu">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{DynamicResource PopupBrush}" BorderBrush="{StaticResource ControlLineBrush}" BorderThickness="1"
                                CornerRadius="14" Padding="5" Margin="0,0,10,10" MinWidth="210">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.4" />
                            </Border.Effect>
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Row" Background="Transparent" CornerRadius="9" Padding="8,8,14,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter x:Name="IconSlot" ContentSource="Icon" VerticalAlignment="Center" HorizontalAlignment="Left"
                                                  TextElement.Foreground="{StaticResource MutedBrush}" TextElement.FontFamily="{DynamicResource IconFont}" />
                                <TextBlock x:Name="Check" Text="&#xE73E;" FontFamily="{DynamicResource IconFont}" FontWeight="{DynamicResource IconWeight}" FontSize="12"
                                           Foreground="{StaticResource AccentTextBrush}" VerticalAlignment="Center" Visibility="Hidden" />
                                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource FaintBrush}" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Margin="6,4" Background="{StaticResource LineBrush}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{DynamicResource PopupBrush}" BorderBrush="{StaticResource ControlLineBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="10,7" MaxWidth="340" Margin="0,0,8,8">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="270" Opacity="0.35" />
                            </Border.Effect>
                            <ContentPresenter>
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Thin scroll bar: a 6 px thumb, no arrows -->
        <Style x:Key="ScrollThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Bar" CornerRadius="3" Background="{StaticResource HoverBrush}" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bar" Property="Background" Value="{StaticResource FaintBrush}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Bar" Property="Background" Value="{StaticResource MutedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10" />
            <Setter Property="MinWidth" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="2,4">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumb}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="Height" Value="10" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" Margin="4,2">
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ScrollThumb}" />
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Color swatch: a round fill (Background) with a ring when chosen (Tag = true) or pointed at -->
        <Style x:Key="Swatch" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Ellipse x:Name="Ring" Stroke="{StaticResource TextBrush}" StrokeThickness="2" Opacity="0" />
                            <Ellipse Margin="5" Fill="{TemplateBinding Background}" Stroke="#30FFFFFF" StrokeThickness="1" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Opacity" Value="0.45" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Ring" Property="Opacity" Value="0.7" />
                            </Trigger>
                            <Trigger Property="Tag">
                                <Trigger.Value><sys:Boolean>True</sys:Boolean></Trigger.Value>
                                <Setter TargetName="Ring" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- "Any color": a rainbow swatch with a plus that opens the color picker (IsChecked = picker open) -->
        <LinearGradientBrush x:Key="RainbowBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF6B6B" Offset="0" />
            <GradientStop Color="#F5B544" Offset="0.25" />
            <GradientStop Color="#6FD38A" Offset="0.5" />
            <GradientStop Color="#4C8DFF" Offset="0.75" />
            <GradientStop Color="#B07CF6" Offset="1" />
        </LinearGradientBrush>
        <Style x:Key="CustomSwatch" TargetType="ToggleButton">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ToolTip" Value="Any color" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent">
                            <Ellipse x:Name="Ring" Stroke="{StaticResource TextBrush}" StrokeThickness="2" Opacity="0" />
                            <Ellipse Margin="5" Fill="{StaticResource RainbowBrush}" />
                            <Ellipse Margin="9" Fill="{TemplateBinding Background}" />
                            <TextBlock Text="&#xE710;" FontFamily="{DynamicResource IconFont}" FontWeight="{DynamicResource IconWeight}" FontSize="9" Foreground="#141414"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Opacity" Value="0.45" />
                            </Trigger>
                            <Trigger Property="Tag">
                                <Trigger.Value><sys:Boolean>True</sys:Boolean></Trigger.Value>
                                <Setter TargetName="Ring" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Next input switch in the corner of an input tile: a small round toggle; on, it is filled (the input is in the
             rotation), off it is a faint ring. Works on the light (current) tile and on the dark ones. -->
        <Style x:Key="CycleToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="ToolTip" Value="Next input: stop on this input (on) or skip it (off)" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Ellipse x:Name="Dot" Fill="#33808080" Stroke="#66808080" StrokeThickness="1" />
                            <TextBlock x:Name="Mark" Text="&#xE8AB;" FontFamily="{DynamicResource IconFont}" FontSize="11"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#99A0A0A0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Dot" Property="Fill" Value="#4CD97B" />
                                <Setter TargetName="Dot" Property="Stroke" Value="#2E9E58" />
                                <Setter TargetName="Mark" Property="Foreground" Value="#0E2A18" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Dot" Property="StrokeThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card that floats over the window (color picker) -->
        <Style x:Key="PopupCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PopupBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ControlLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="8" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.5" />
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Glyph toggle in the header (the gear of the Settings view): filled in the accent while its view is open -->
        <Style x:Key="IconToggle" TargetType="ToggleButton">
            <Setter Property="FontFamily" Value="{DynamicResource IconFont}" />
            <Setter Property="FontWeight" Value="{DynamicResource IconWeight}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="Surface" Background="Transparent" CornerRadius="17" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{StaticResource HoverBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{StaticResource PillOnBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource PillOnTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- One of a few looks to choose (appearance): a card with a preview, ringed when chosen -->
        <Style x:Key="OptionCard" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="Width" Value="190" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Box" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                CornerRadius="16" Padding="10">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource RaisedBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource TextBrush}" />
                                <Setter TargetName="Box" Property="BorderThickness" Value="1.5" />
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource RaisedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Any text block that shows an icon of the Windows icon font takes the chosen icon style (IconRestyler) -->
        <Style TargetType="TextBlock">
            <EventSetter Event="Loaded" Handler="RestyleIcon" />
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <app:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
    </Application.Resources>
</Application>
