<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 10.0.19041: the Windows media session API (what is playing, to control it from the phone's Remote tab). -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Only for the tray icon (NotifyIcon). WinForms names are always fully qualified. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>SwitchMonitor</AssemblyName>
    <RootNamespace>SwitchMonitor.App</RootNamespace>
    <ApplicationIcon>..\..\monitor-switch.ico</ApplicationIcon>
    <Version>2.0.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SwitchMonitor.Core\SwitchMonitor.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Inside the program itself (not as a loose file beside the exe: a Content copy with the same name would make the
         pack URI point at that file, and the single-file publish has none). The window and the tray read it from here. -->
    <Resource Include="..\..\monitor-switch.ico" Link="monitor-switch.ico" />
  </ItemGroup>

  <!-- Phosphor icons (MIT, see Fonts\PHOSPHOR-LICENSE.txt): the Fill and Duotone icon styles -->
  <ItemGroup>
    <Resource Include="Fonts\Phosphor-Fill.ttf" />
    <Resource Include="Fonts\Phosphor-Duotone.ttf" />
    <None Include="Fonts\PHOSPHOR-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
