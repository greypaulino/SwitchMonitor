<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Only for the tray icon (NotifyIcon). WinForms names are always fully qualified. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>SwitchMonitor</AssemblyName>
    <RootNamespace>SwitchMonitor.App</RootNamespace>
    <ApplicationIcon>..\..\monitor-switch.ico</ApplicationIcon>
    <Version>2.0.0-alpha.2</Version>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SwitchMonitor.Core\SwitchMonitor.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\monitor-switch.ico" Link="monitor-switch.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
