<Window x:Class="SwitchMonitor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SwitchMonitor.App.ViewModels"
        Title="SwitchMonitor v2 (preview)" Width="920" Height="760" MinWidth="700" MinHeight="460"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="ChipRemove" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="ToolTip" Value="Remove" />
        </Style>
        <!-- A control row disappears when its mode rule says so (LG red/green/blue outside the Custom modes) -->
        <Style x:Key="ControlRow" TargetType="ContentPresenter">
            <Setter Property="Visibility" Value="{Binding IsShown, Converter={StaticResource BoolToVisibility}}" />
        </Style>
        <!-- The name column of every control row: one width for the whole panel, long names end in … with the full name as tooltip -->
        <Style x:Key="RowName" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Style>
        <!-- Rows of the list on the left (displays, profiles) -->
        <Style x:Key="ListRow" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" CornerRadius="6" Padding="{TemplateBinding Padding}" Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource RaisedBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Control templates of the Displays tab -->
        <DataTemplate DataType="{x:Type vm:SliderControlViewModel}">
            <Grid x:Name="Row" Margin="0,0,0,10" ToolTip="{Binding ToolTipText}" ToolTipService.ShowOnDisabled="True"
                  Background="Transparent" MinHeight="30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="52" />
                    <ColumnDefinition Width="36" />
                </Grid.ColumnDefinitions>
                <!-- Volume: the speaker next to the name mutes / unmutes -->
                <DockPanel>
                    <Button x:Name="Speaker" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="28" Height="28"
                            Content="{Binding SpeakerGlyph}" Command="{Binding ToggleMuteCommand}" Margin="0,0,8,0"
                            ToolTip="Mute / unmute" Visibility="Collapsed" />
                    <TextBlock x:Name="SliderName" Text="{Binding Name}" Style="{StaticResource RowName}" />
                </DockPanel>
                <Slider x:Name="Bar" Grid.Column="1" Value="{Binding Value, Mode=TwoWay}" IsEnabled="{Binding IsEnabled}"
                        SmallChange="{Binding SmallStep}" LargeChange="{Binding LargeStep}"
                        TickFrequency="{Binding TickStep}" Ticks="{Binding TickValues}" IsSnapToTickEnabled="{Binding SnapsToSteps}"
                        AutomationProperties.Name="{Binding Name}" />
                <TextBlock x:Name="Percent" Grid.Column="2" Text="{Binding ValueText}" Style="{StaticResource Figure}" />
                <Button x:Name="Reset" Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE7A7;" FontSize="12"
                        HorizontalAlignment="Right" Command="{Binding ResetCommand}"
                        ToolTip="Factory value for the current mode"
                        Visibility="{Binding CanReset, Converter={StaticResource BoolToVisibility}}" />
                <!-- Value not read yet (laptop brightness right after sign-in): read it again now -->
                <Button x:Name="Retry" Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE72C;" FontSize="12"
                        HorizontalAlignment="Right" Command="{Binding RetryCommand}" Foreground="{StaticResource WarningTextBrush}"
                        ToolTip="Could not be read yet. Read it again" Visibility="Collapsed" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsUnread}" Value="True">
                    <Setter TargetName="Reset" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Retry" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Speaker" Property="IsEnabled" Value="False" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasMute}" Value="True">
                    <Setter TargetName="Speaker" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                    <Setter TargetName="SliderName" Property="Opacity" Value="0.45" />
                    <Setter TargetName="Bar" Property="Opacity" Value="0.45" />
                    <Setter TargetName="Percent" Property="Opacity" Value="0.45" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ToggleControlViewModel}">
            <!-- Locked by the current picture mode: dimmed, with the reason as tooltip -->
            <Grid Margin="0,0,0,10" IsEnabled="{Binding IsEnabled}" ToolTip="{Binding ToolTipText}" ToolTipService.ShowOnDisabled="True"
                  Background="Transparent" MinHeight="30">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}" Style="{StaticResource RowName}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding IsOn, Mode=TwoWay}" AutomationProperties.Name="{Binding Name}" />
                    <TextBlock Text="{Binding StateText}" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ChoiceControlViewModel}">
            <!-- Locked by the current picture mode: dimmed, with the reason as tooltip -->
            <Grid Margin="0,0,0,10" IsEnabled="{Binding IsEnabled}" ToolTip="{Binding ToolTipText}" ToolTipService.ShowOnDisabled="True"
                  Background="Transparent">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}" Style="{StaticResource RowName}" />
                <ComboBox Grid.Column="1" HorizontalAlignment="Left" MinWidth="200" ItemsSource="{Binding Options}"
                          SelectedItem="{Binding Selected, Mode=TwoWay}" AutomationProperties.Name="{Binding Name}" />
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReadOnlyControlViewModel}">
            <Grid Margin="0,0,0,10" ToolTip="{Binding Note}" MinHeight="30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}" Foreground="{StaticResource MutedBrush}" Style="{StaticResource RowName}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Text}" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Text="Read-only" Foreground="{StaticResource FaintBrush}" FontSize="11" Margin="10,1,0,0" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Views -->
        <Border Background="{StaticResource PanelBrush}" Padding="12,0,12,0" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE712;" FontSize="16" Margin="4,0,0,0"
                        ToolTip="Options" AutomationProperties.Name="Options" Click="ShowOptions">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Linked apps switch profiles" IsCheckable="True"
                                      IsChecked="{Binding LinkedAppsEnabled, Mode=TwoWay}" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource QuietButton}" Command="{Binding RefreshCommand}"
                        ToolTip="Look for displays again (after connecting or turning one on)" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,1,8,0" />
                        <TextBlock Text="Refresh displays" />
                    </StackPanel>
                </Button>
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource TabButton}" Content="Displays" IsChecked="{Binding IsDisplaysTab, Mode=TwoWay}" />
                    <RadioButton Style="{StaticResource TabButton}" Content="Profiles" IsChecked="{Binding IsProfilesTab, Mode=TwoWay}" />
                    <RadioButton Style="{StaticResource TabButton}" Content="Shortcuts" IsChecked="{Binding IsShortcutsTab, Mode=TwoWay}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Shortcut problems stay visible until fixed -->
        <Border Grid.Row="1" Background="{StaticResource WarningBrush}" Padding="16,10"
                Visibility="{Binding HasShortcutWarning, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Retry" Margin="8,0,0,0" Command="{Binding RetryShortcutsCommand}" />
                <Button DockPanel.Dock="Right" Content="Edit shortcuts" Margin="12,0,0,0" Command="{Binding OpenShortcutsCommand}" />
                <TextBlock Text="{Binding ShortcutWarning}" Foreground="{StaticResource WarningTextBrush}"
                           TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- Displays view: the profile in use across the top, the display list on the left, its controls on the right -->
        <Grid Grid.Row="2" Visibility="{Binding ShowsMonitorList, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Profiles apply to every display, so they sit above both columns -->
            <Border Grid.ColumnSpan="2" Padding="20,12,20,6" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                <DockPanel>
                    <TextBlock Text="Profile" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold" FontSize="12"
                               VerticalAlignment="Top" Margin="0,10,16,0" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource QuietButton}" VerticalAlignment="Top" Margin="0,2,0,0"
                            Command="{Binding UndoProfileCommand}" ToolTip="Back to the settings the displays had before this profile"
                            Visibility="{Binding CanUndoProfile, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7A7;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,1,8,0" />
                            <TextBlock Text="Undo" />
                        </StackPanel>
                    </Button>
                    <ItemsControl ItemsSource="{Binding Scenes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SceneViewModel}">
                                <Button x:Name="SceneButton" Style="{StaticResource SegmentButton}" Command="{Binding ApplyCommand}"
                                        Margin="0,0,6,6" ToolTip="{Binding Summary}" MaxWidth="240">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="SceneName" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="SceneKey" Text="{Binding Hotkey}" Foreground="{StaticResource FaintBrush}"
                                                   FontSize="11" Margin="8,1,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter TargetName="SceneButton" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                        <Setter TargetName="SceneButton" Property="Foreground" Value="{StaticResource AccentTextBrush}" />
                                        <Setter TargetName="SceneName" Property="FontWeight" Value="SemiBold" />
                                        <Setter TargetName="SceneKey" Property="Foreground" Value="{StaticResource AccentTextBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <!-- Displays -->
            <ListBox Grid.Row="1" ItemsSource="{Binding Monitors}" SelectedItem="{Binding Selected}"
                     Background="{StaticResource PanelBrush}" BorderThickness="0,0,1,0" Foreground="{StaticResource TextBrush}"
                     BorderBrush="{StaticResource LineBrush}" Padding="8" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ItemContainerStyle="{StaticResource ListRow}" AutomationProperties.Name="Displays">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:MonitorViewModel}">
                        <StackPanel ToolTip="{Binding Details}">
                            <TextBlock x:Name="Title" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="Sub" Text="{Binding Subtitle}" Foreground="{StaticResource MutedBrush}" FontSize="12"
                                       TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsControllable}" Value="False">
                                <Setter TargetName="Title" Property="Foreground" Value="{StaticResource MutedBrush}" />
                                <Setter TargetName="Sub" Property="Foreground" Value="{StaticResource FaintBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- No display found at all -->
            <StackPanel Grid.Row="1" Grid.Column="1" Margin="28,26" MaxWidth="460" HorizontalAlignment="Left">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Monitors.Count}" Value="0" />
                                    <Condition Binding="{Binding IsBusy}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="No displays found" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8" />
                <TextBlock Style="{StaticResource Hint}" FontSize="13" Margin="0,0,0,16"
                           Text="Windows reported no monitors the app can see. Connect or turn on a display, then look again." />
                <Button Content="Refresh displays" Command="{Binding RefreshCommand}" HorizontalAlignment="Left" />
            </StackPanel>

            <!-- Controls of the selected display -->
            <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="28,22,20,22">
                <StackPanel DataContext="{Binding Selected}">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <DockPanel Margin="0,0,0,2">
                        <Button DockPanel.Dock="Right" Style="{StaticResource DangerButton}" Margin="4,0,0,0" VerticalAlignment="Top"
                                Content="{Binding DataContext.ResetLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                                Command="{Binding DataContext.ResetAllCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                Visibility="{Binding CanResetAll, Converter={StaticResource BoolToVisibility}}"
                                ToolTip="Factory brightness, contrast and colors for the current picture mode. Click twice." />
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE72C;" VerticalAlignment="Top"
                                Command="{Binding DataContext.ReloadValuesCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                ToolTip="Read every value again (after changing something on the monitor's own menu)"
                                AutomationProperties.Name="Read values again"
                                Visibility="{Binding IsControllable, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Details}" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,22" />

                    <!-- A display Windows is not using, or one the app cannot reach: say so, and what to do -->
                    <Border Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="16,14" Margin="0,0,0,12"
                            Visibility="{Binding IsControllable, Converter={StaticResource InverseBoolToVisibility}}">
                        <TextBlock Style="{StaticResource Hint}" FontSize="13" Foreground="{StaticResource MutedBrush}"
                                   Text="Nothing to adjust here right now. Turn the display on or reconnect it, then use Refresh displays." />
                    </Border>

                    <TextBlock Text="Reading the monitor's settings…" Foreground="{StaticResource MutedBrush}"
                               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,12" />
                    <TextBlock Text="{Binding LoadError}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,0,0,12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LoadError}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <StackPanel Visibility="{Binding HasInputs, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,18">
                        <TextBlock Text="Input" Style="{StaticResource SectionTitle}" />
                        <ItemsControl ItemsSource="{Binding Inputs}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:InputViewModel}">
                                    <Button x:Name="InputButton" Style="{StaticResource SegmentButton}" Command="{Binding SelectCommand}"
                                            MinWidth="116" Margin="0,0,6,6" Padding="14,7">
                                        <StackPanel>
                                            <TextBlock x:Name="InputLabel" Text="{Binding Label}" HorizontalAlignment="Center" />
                                            <TextBlock x:Name="InputKey" Text="{Binding Shortcut}" Foreground="{StaticResource FaintBrush}" FontSize="11"
                                                       HorizontalAlignment="Center" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                            <Setter TargetName="InputButton" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                            <Setter TargetName="InputButton" Property="Foreground" Value="{StaticResource AccentTextBrush}" />
                                            <Setter TargetName="InputLabel" Property="FontWeight" Value="SemiBold" />
                                            <Setter TargetName="InputKey" Property="Foreground" Value="{StaticResource AccentTextBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- Which inputs Next input visits: the ones with another computer connected -->
                        <DockPanel Margin="0,6,0,0">
                            <TextBlock DockPanel.Dock="Left" Text="Next input (Ctrl+Alt+M) visits" Foreground="{StaticResource MutedBrush}"
                                       VerticalAlignment="Top" Margin="0,5,12,0" FontSize="12" />
                            <ItemsControl ItemsSource="{Binding Inputs}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:InputViewModel}">
                                        <ToggleButton Style="{StaticResource ChipToggle}" Content="{Binding Label}" IsChecked="{Binding InCycle, Mode=TwoWay}"
                                                      ToolTip="Include this input when Next input goes round" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Hint}" Text="Press it again within 10 s to go back. The tray menu can also return to the previous input." />
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsControllable, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Settings">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Controls.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding Controls}" ItemContainerStyle="{StaticResource ControlRow}" />
                    </StackPanel>

                    <!-- Color fine-tuning: red/green/blue and black levels, or the software color of a built-in screen -->
                    <Expander Style="{StaticResource Disclosure}" Margin="0,14,0,0"
                              IsExpanded="{Binding DataContext.ShowAdvanced, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=Window}}"
                              Visibility="{Binding HasColorTuning, Converter={StaticResource BoolToVisibility}}">
                        <Expander.Header>
                            <TextBlock Text="Color fine-tuning" Foreground="{StaticResource MutedBrush}" FontSize="12" FontWeight="SemiBold" />
                        </Expander.Header>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,14"
                                       Text="The monitor's own red, green and blue work only in its Custom picture modes. To keep a combination, save it as a profile." />
                            <TextBlock Text="{Binding AdvancedHint}" Foreground="{StaticResource WarningTextBrush}" TextWrapping="Wrap" Margin="0,0,0,12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AdvancedHint}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding AdvancedControls}" ItemContainerStyle="{StaticResource ControlRow}" />
                            <TextBlock Text="{Binding NoAdvancedText}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                       Visibility="{Binding HasNoAdvanced, Converter={StaticResource BoolToVisibility}}" />

                            <!-- Software color: made by the graphics card, only for built-in panels (they have no color controls) -->
                            <StackPanel DataContext="{Binding SoftwareColor}" Margin="0,18,0,0"
                                        Visibility="{Binding DataContext.HasSoftwareColor, RelativeSource={RelativeSource AncestorType=Expander}, Converter={StaticResource BoolToVisibility}}">
                                <DockPanel Margin="0,0,0,6">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource QuietButton}" Content="Neutral" Command="{Binding ResetCommand}"
                                            ToolTip="Back to 6500 K and full red, green and blue" />
                                    <TextBlock Text="Software color" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12"
                                           Text="Made by the graphics card, because this screen has no color controls of its own. Turn Windows Night light off while using it." />
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="88" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Temperature" Style="{StaticResource RowName}" />
                                    <Slider Grid.Column="1" Minimum="{Binding MinKelvin}" Maximum="{Binding MaxKelvin}" SmallChange="100" LargeChange="500"
                                            Value="{Binding Kelvin, Mode=TwoWay}" AutomationProperties.Name="Temperature" />
                                    <TextBlock Grid.Column="2" Text="{Binding KelvinText}" Style="{StaticResource Figure}" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="160,0,0,14">
                                    <Button Content="Warm 5000 K" Command="{Binding PresetCommand}" CommandParameter="5000" Margin="0,0,6,0" />
                                    <Button Content="Medium 7500 K" Command="{Binding PresetCommand}" CommandParameter="7500" Margin="0,0,6,0" />
                                    <Button Content="Cool 9300 K" Command="{Binding PresetCommand}" CommandParameter="9300" />
                                </StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="52" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Red" Style="{StaticResource RowName}" />
                                    <Slider Grid.Column="1" Value="{Binding Red, Mode=TwoWay}" AutomationProperties.Name="Red" />
                                    <TextBlock Grid.Column="2" Text="{Binding RedText}" Style="{StaticResource Figure}" />
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="52" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Green" Style="{StaticResource RowName}" />
                                    <Slider Grid.Column="1" Value="{Binding Green, Mode=TwoWay}" AutomationProperties.Name="Green" />
                                    <TextBlock Grid.Column="2" Text="{Binding GreenText}" Style="{StaticResource Figure}" />
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="52" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Blue" Style="{StaticResource RowName}" />
                                    <Slider Grid.Column="1" Value="{Binding Blue, Mode=TwoWay}" AutomationProperties.Name="Blue" />
                                    <TextBlock Grid.Column="2" Text="{Binding BlueText}" Style="{StaticResource Figure}" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Profiles view -->
        <Grid Grid.Row="2" DataContext="{Binding ProfileEditor}"
              Visibility="{Binding DataContext.IsProfilesTab, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
            <Grid.Resources>
                <Style x:Key="EditorSection" TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}">
                    <Setter Property="Margin" Value="0,18,0,10" />
                </Style>
                <!-- One setting of the profile (normal, advanced or not on this display) -->
                <DataTemplate x:Key="SettingRowTemplate" DataType="{x:Type vm:ProfileSettingRowViewModel}">
                    <Grid x:Name="SettingRow" Margin="0,0,0,8" MinHeight="30"
                          Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="52" />
                        </Grid.ColumnDefinitions>
                        <!-- Volume: the speaker next to the name mutes / unmutes, as on the Displays tab -->
                        <DockPanel>
                            <Button x:Name="SettingSpeaker" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="28" Height="28"
                                    Content="{Binding SpeakerGlyph}" Command="{Binding ToggleMuteCommand}" Margin="0,0,8,0"
                                    ToolTip="{Binding SpeakerToolTip}" Visibility="Collapsed" />
                            <TextBlock x:Name="SettingName" Text="{Binding Name}" Style="{StaticResource RowName}" />
                        </DockPanel>
                        <Slider x:Name="SettingSlider" Grid.Column="1" Value="{Binding Percent, Mode=TwoWay}" Visibility="Collapsed"
                                AutomationProperties.Name="{Binding Name}" />
                        <TextBlock x:Name="SettingPercent" Grid.Column="2" Text="{Binding PercentText}" Style="{StaticResource Figure}"
                                   Visibility="Collapsed" />
                        <ComboBox x:Name="SettingChoice" Grid.Column="1" HorizontalAlignment="Left" MinWidth="200" ItemsSource="{Binding Options}"
                                  SelectedItem="{Binding Selected, Mode=TwoWay}" Visibility="Collapsed" AutomationProperties.Name="{Binding Name}" />
                        <TextBlock x:Name="SettingFixed" Grid.Column="1" Text="{Binding FixedText}"
                                   Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Visibility="Collapsed"
                                   ToolTip="This display does not have this control; the line is kept as saved" />
                        <Button x:Name="SettingRemove" Grid.Column="2" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource ChipRemove}"
                                HorizontalAlignment="Right" Command="{Binding RemoveCommand}" Visibility="Collapsed"
                                ToolTip="Remove this line from the profile" />
                    </Grid>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsContinuous}" Value="True">
                            <Setter TargetName="SettingSlider" Property="Visibility" Value="Visible" />
                            <Setter TargetName="SettingPercent" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding HasMute}" Value="True">
                            <Setter TargetName="SettingSpeaker" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsMuted}" Value="True">
                            <Setter TargetName="SettingSlider" Property="IsEnabled" Value="False" />
                            <Setter TargetName="SettingSlider" Property="Opacity" Value="0.45" />
                            <Setter TargetName="SettingPercent" Property="Opacity" Value="0.45" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsChoice}" Value="True">
                            <Setter TargetName="SettingChoice" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                            <Setter TargetName="SettingFixed" Property="Visibility" Value="Visible" />
                            <Setter TargetName="SettingRemove" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </Grid.Resources>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Profile list -->
            <DockPanel Background="{StaticResource PanelBrush}">
                <Border DockPanel.Dock="Right" Width="1" Background="{StaticResource LineBrush}" />
                <Button DockPanel.Dock="Top" Margin="8,10,8,6" Click="ShowOptions" HorizontalContentAlignment="Stretch"
                        ToolTip="Add a profile from a template, or a new one from the current values">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                   VerticalAlignment="Center" Margin="8,0,0,0" />
                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" Margin="0,1,8,0" />
                        <TextBlock Text="Add profile" />
                    </DockPanel>
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="From a template" IsEnabled="False" />
                            <MenuItem Header="Work" Command="{Binding AddTemplateCommand}" CommandParameter="Work"
                                      ToolTip="Neutral 6500 K, about 120 cd/m², Custom or Standard mode" />
                            <MenuItem Header="Night" Command="{Binding AddTemplateCommand}" CommandParameter="Night"
                                      ToolTip="Dim and warm: Reader mode on the LG, 5000 K on other monitors" />
                            <MenuItem Header="Game" Command="{Binding AddTemplateCommand}" CommandParameter="Game"
                                      ToolTip="Custom (Game) mode on the LG, bright, middle response time, FreeSync on" />
                            <MenuItem Header="Theater" Command="{Binding AddTemplateCommand}" CommandParameter="Theater"
                                      ToolTip="Cinema mode, about 100 cd/m² for a dark room, 6500 K" />
                            <Separator />
                            <MenuItem Header="New profile from the current values" Command="{Binding NewProfileCommand}"
                                      ToolTip="Start from the current values of the display" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" Background="Transparent"
                         Foreground="{StaticResource TextBrush}" ItemContainerStyle="{StaticResource ListRow}"
                         BorderThickness="0" Padding="8,2,8,8" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="Profiles">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ProfileListItem}">
                            <StackPanel ToolTip="{Binding Name}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Hotkey}" Foreground="{StaticResource FaintBrush}" FontSize="11"
                                               Margin="8,1,0,0" />
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                                <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" FontSize="12"
                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Editor -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="28,20,20,20">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,18" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Name" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxWidth="320"
                                 HorizontalAlignment="Left" MinWidth="240" MaxLength="40" IsReadOnly="{Binding IsCustom}"
                                 AutomationProperties.Name="Profile name">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCustom}" Value="True">
                                            <Setter Property="Opacity" Value="0.6" />
                                            <Setter Property="Focusable" Value="False" />
                                            <Setter Property="ToolTip" Value="Custom is your own settings; its name cannot change. Use Add profile to keep a set under a name." />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <TextBlock Grid.Row="1" Text="Values from" VerticalAlignment="Center" Margin="0,10,0,0" />
                        <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Sources}" SelectedItem="{Binding Source}"
                                  DisplayMemberPath="Name" HorizontalAlignment="Left" Margin="0,10,0,0" MinWidth="240"
                                  ToolTip="The display whose controls are listed below and whose current values Capture copies" />
                        <CheckBox Grid.Row="2" Grid.Column="1" Content="{Binding OnlyThisDisplayLabel}" Margin="0,12,0,0"
                                  IsChecked="{Binding OnlyThisDisplay, Mode=TwoWay}"
                                  ToolTip="Unticked, the profile applies to every display that has these controls" />
                    </Grid>
                    <TextBlock Text="{Binding HotkeyText}" Style="{StaticResource Hint}" Margin="160,0,0,4" />

                    <TextBlock Text="Settings" Style="{StaticResource EditorSection}" />
                    <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource SettingRowTemplate}" />

                    <!-- Advanced: a heading like Settings with an expand chevron; open = part of the profile -->
                    <Button Command="{Binding ToggleAdvancedCommand}" HorizontalAlignment="Left" Cursor="Hand"
                            ToolTip="{Binding AdvancedToolTip}" FocusVisualStyle="{StaticResource FocusRing}"
                            Visibility="{Binding HasAdvancedRows, Converter={StaticResource BoolToVisibility}}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <StackPanel x:Name="Heading" Orientation="Horizontal" Background="Transparent" Margin="0,18,0,10">
                                    <TextBlock Text="{Binding AdvancedGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                               Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,1,8,0" />
                                    <TextBlock Text="Advanced" Foreground="{StaticResource MutedBrush}" FontSize="12" FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Heading" Property="Opacity" Value="0.8" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <ItemsControl ItemsSource="{Binding AdvancedRows}" ItemTemplate="{StaticResource SettingRowTemplate}" />

                    <TextBlock Text="Not on this display" Style="{StaticResource EditorSection}"
                               Visibility="{Binding HasMissingRows, Converter={StaticResource BoolToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding MissingRows}" ItemTemplate="{StaticResource SettingRowTemplate}" />

                    <!-- Linked programs: the profile turns on (gradually) while one of them is in front -->
                    <StackPanel Visibility="{Binding CanAutomate, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Linked apps" Style="{StaticResource EditorSection}" Margin="0,24,0,8" />
                        <TextBlock Text="{Binding LinkedAppsHint}" Style="{StaticResource Hint}" Margin="0,0,0,10" />
                        <ItemsControl ItemsSource="{Binding LinkedApps}" Margin="0,0,0,8"
                                      Visibility="{Binding HasLinkedApps, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource RaisedBrush}" CornerRadius="13" Padding="12,4,4,4" Margin="0,0,6,6">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Exe}" VerticalAlignment="Center" FontSize="12" />
                                            <Button Content="&#xE711;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource ChipRemove}"
                                                    Command="{Binding RemoveCommand}" Margin="6,0,0,0" ToolTip="Unlink this program" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal">
                            <Button Click="ShowRunningApps" Margin="0,0,6,0" ToolTip="Pick one of the programs open now">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Add open app" />
                                    <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="9" VerticalAlignment="Center" Margin="8,0,0,0" />
                                </StackPanel>
                                <Button.ContextMenu>
                                    <ContextMenu ItemsSource="{Binding RunningApps}">
                                        <ContextMenu.ItemContainerStyle>
                                            <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                <Setter Property="Header" Value="{Binding Label}" />
                                                <Setter Property="Command" Value="{Binding AddCommand}" />
                                            </Style>
                                        </ContextMenu.ItemContainerStyle>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                            <Button Content="Browse…" Command="{Binding BrowseAppCommand}" Style="{StaticResource QuietButton}"
                                    ToolTip="Choose a program file (.exe), also one that is not open now" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{StaticResource PanelBrush}" Padding="20,12"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="{Binding DeleteLabel}" Command="{Binding DeleteCommand}" Style="{StaticResource DangerButton}" Margin="0,0,6,0" />
                        <Button Content="Revert" Command="{Binding RevertCommand}" Style="{StaticResource QuietButton}" Margin="0,0,6,0"
                                ToolTip="Discard the changes not saved yet" />
                        <Button Content="Capture current" Command="{Binding CaptureCommand}" Margin="0,0,6,0"
                                ToolTip="Copy what the display shows now into every line" />
                        <Button Content="Try" Command="{Binding TryCommand}" Margin="0,0,6,0" ToolTip="Apply the profile as it is here, without saving">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource FlatButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCustom}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="{Binding SaveLabel}" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}"
                                ToolTip="{Binding SaveToolTip}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource WarningTextBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Shortcuts view (global shortcuts are paused while it is shown) -->
        <Grid Grid.Row="2" DataContext="{Binding ShortcutEditor}"
              Visibility="{Binding DataContext.IsShortcutsTab, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
            <Grid.Resources>
            <CollectionViewSource x:Key="GroupedRows" Source="{Binding Rows}">
                <CollectionViewSource.GroupDescriptions>
                    <PropertyGroupDescription PropertyName="Group" />
                </CollectionViewSource.GroupDescriptions>
            </CollectionViewSource>
            </Grid.Resources>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Margin="24,16,24,0" Style="{StaticResource Hint}" FontSize="13" Foreground="{StaticResource MutedBrush}"
                       Text="Shortcuts are paused while this tab is open, so you can record one by pressing it. Each action can have several (for example keypad and main keyboard)." />
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,6,20,14">
                <ItemsControl ItemsSource="{Binding Source={StaticResource GroupedRows}}">
                    <ItemsControl.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource SectionTitle}" Margin="5,20,0,4" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ItemsControl.GroupStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ShortcutRowViewModel}">
                            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource RowName}" />
                                    <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                        <ItemsControl ItemsSource="{Binding Chords}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:ChordChipViewModel}">
                                                    <Border x:Name="Chip" Background="{StaticResource RaisedBrush}" CornerRadius="6"
                                                            BorderThickness="1" BorderBrush="Transparent" Padding="10,4,3,4" Margin="0,2,6,2"
                                                            ToolTip="{Binding Problem}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Text}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                                            <Button Content="&#xE711;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource ChipRemove}"
                                                                    Command="{Binding RemoveCommand}" />
                                                        </StackPanel>
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding HasProblem}" Value="True">
                                                            <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource WarningTextBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsBlocking}" Value="True">
                                                            <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource ErrorBrush}" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button x:Name="AddButton" Content="{Binding AddLabel}" Command="{Binding AddCommand}"
                                                Padding="10,4" MinHeight="30" Margin="0,2,0,2" Background="Transparent"
                                                Foreground="{StaticResource MutedBrush}"
                                                BorderBrush="{StaticResource ControlLineBrush}" BorderThickness="1" />
                                    </WrapPanel>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsCapturing}" Value="True">
                                    <Setter TargetName="AddButton" Property="BorderBrush" Value="{StaticResource AccentTextBrush}" />
                                    <Setter TargetName="AddButton" Property="Foreground" Value="{StaticResource AccentTextBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Grid.Row="2" Background="{StaticResource PanelBrush}" Padding="20,12" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Restore defaults" Command="{Binding RestoreDefaultsCommand}" Style="{StaticResource QuietButton}" Margin="0,0,6,0" />
                        <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,6,0" />
                        <Button Content="Save" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" />
                    </StackPanel>
                    <TextBlock x:Name="MessageText" Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource WarningTextBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Status: what the last action did. Confirmations fade after a few seconds; problems stay in the error color. -->
        <Border Grid.Row="3" Background="{StaticResource PanelBrush}" Padding="20,8" MinHeight="34"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusText" Text="{Binding Status}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                       FontSize="12">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>
    </Grid>
</Window>
