<UserControl x:Class="SwitchMonitor.App.AppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SwitchMonitor.App.ViewModels"
             xmlns:vmAuto="clr-namespace:SwitchMonitor.App.Automation">
    <Grid Margin="22,0,22,8" x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Margin="2,0,2,14" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" FontSize="14" Foreground="{StaticResource MutedBrush}"
                   Text="Set up your programs on the display you prefer. Just drag them." />
        <!-- One column for the programs, one for each display of this computer -->
        <ItemsControl x:Name="ColumnsList" Grid.Row="1" ItemsSource="{Binding Columns}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:AppColumn}">
                    <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="12,14" Background="{StaticResource CardBrush}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontSize="15" Margin="0,2,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Hint}" FontSize="11" HorizontalAlignment="Center" />
                            </StackPanel>
                            <!-- The list of programs: its search and the kinds of program to show -->
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10" Visibility="{Binding IsPool, Converter={StaticResource BoolToVisibility}}">
                                <Grid>
                                    <TextBox x:Name="SearchBox" Text="{Binding DataContext.Search, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="34,0,8,0" AutomationProperties.Name="Search programs" ToolTip="Search programs" />
                                    <TextBlock Text="&#xE721;" FontFamily="{DynamicResource IconFont}" FontWeight="{DynamicResource IconWeight}" FontSize="13" IsHitTestVisible="False" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock Text="Search" IsHitTestVisible="False" VerticalAlignment="Center" Margin="34,0,0,0" Foreground="{StaticResource MutedBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <WrapPanel Margin="0,8,0,0" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <RadioButton Style="{StaticResource TabButton}" ToolTip="All" GroupName="AppKind" IsChecked="{Binding DataContext.IsAll, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}" Margin="0,0,4,4">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE71D;" FontFamily="{DynamicResource IconFont}" FontWeight="{DynamicResource IconWeight}" FontSize="13" VerticalAlignment="Center" Margin="0,1,7,0" /><TextBlock Text="All" VerticalAlignment="Center" /></StackPanel>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource TabButton}" ToolTip="Most used" GroupName="AppKind" IsChecked="{Binding DataContext.IsUsed, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}" Margin="0,0,4,4">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE734;" FontFamily="{DynamicResource IconFont}" FontWeight="{DynamicResource IconWeight}" FontSize="13" VerticalAlignment="Center" Margin="0,1,7,0" /><TextBlock Text="Most used" VerticalAlignment="Center" /></StackPanel>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource TabButton}" ToolTip="System" GroupName="AppKind" IsChecked="{Binding DataContext.IsSystem, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}" Margin="0,0,4,4">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE770;" FontFamily="{DynamicResource IconFont}" FontWeight="{DynamicResource IconWeight}" FontSize="13" VerticalAlignment="Center" Margin="0,1,7,0" /><TextBlock Text="System" VerticalAlignment="Center" /></StackPanel>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource TabButton}" ToolTip="User apps" GroupName="AppKind" IsChecked="{Binding DataContext.IsUser, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}" Margin="0,0,4,4">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE77B;" FontFamily="{DynamicResource IconFont}" FontWeight="{DynamicResource IconWeight}" FontSize="13" VerticalAlignment="Center" Margin="0,1,7,0" /><TextBlock Text="User apps" VerticalAlignment="Center" /></StackPanel>
                                    </RadioButton>
                                </WrapPanel>
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Bottom" Text="{Binding Hint}" Style="{StaticResource Hint}" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Background="Transparent">
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.Style>
                                        <Style TargetType="ItemsControl">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPool}" Value="True">
                                                    <Setter Property="ItemsPanel">
                                                        <Setter.Value><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ItemsControl.Style>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:AppChip}">
                                            <Border Margin="2" Padding="8,6" CornerRadius="10" Background="{Binding Fill}" Cursor="Hand"
                                                    PreviewMouseLeftButtonDown="ChipDown" ToolTip="{Binding Tip}">
                                                <DockPanel>
                                                    <ComboBox DockPanel.Dock="Right" Width="124" Height="26" FontSize="11" Margin="8,0,0,0" ItemsSource="{Binding DataContext.Modes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              SelectedValuePath="Name" SelectedValue="{Binding Mode, Mode=OneWay}" SelectionChanged="ModePicked" ToolTip="How it opens on this display"
                                                              Visibility="{Binding DataContext.IsPool, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource InverseBoolToVisibility}}">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type vmAuto:OpenModeOption}">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding Symbol}" FontFamily="{Binding Font}" Width="18" FontSize="12" VerticalAlignment="Center" />
                                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                    <Image DockPanel.Dock="Left" Source="{Binding Icon}" Width="20" Height="20" Margin="0,0,10,0" />
                                                    <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <!-- The pill that follows the pointer while a program is dragged -->
        <Canvas Grid.RowSpan="2" IsHitTestVisible="False">
            <Border x:Name="Ghost" Visibility="Collapsed" CornerRadius="10" MinWidth="140" Background="#FF262626">
                <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.5" /></Border.Effect>
                <Border x:Name="GhostTint" Padding="8,6" CornerRadius="10">
                    <DockPanel>
                        <Image x:Name="GhostIcon" DockPanel.Dock="Left" Width="20" Height="20" Margin="0,0,10,0" />
                        <TextBlock x:Name="GhostName" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>
            </Border>
        </Canvas>
    </Grid>
</UserControl>
