<UserControl x:Class="SwitchMonitor.App.ColorPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="236">
    <!-- Any color: saturation (left to right) and brightness (top to bottom) on the square, hue on the strip, or typed -->
    <StackPanel>
        <Grid x:Name="Field" Height="150" Cursor="Cross" Background="Transparent" ClipToBounds="True"
              MouseLeftButtonDown="FieldDown" MouseMove="FieldMove" MouseLeftButtonUp="ReleaseMouse">
            <Border x:Name="HueFill" CornerRadius="10" Background="Red" />
            <Border CornerRadius="10">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FFFFFFFF" Offset="0" />
                        <GradientStop Color="#00FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Border CornerRadius="10">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00000000" Offset="0" />
                        <GradientStop Color="#FF000000" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Canvas IsHitTestVisible="False">
                <Ellipse x:Name="FieldThumb" Width="16" Height="16" Stroke="White" StrokeThickness="2">
                    <Ellipse.Effect>
                        <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.6" />
                    </Ellipse.Effect>
                </Ellipse>
            </Canvas>
        </Grid>
        <Grid x:Name="HueStrip" Height="14" Margin="0,12,0,0" Cursor="Hand" Background="Transparent"
              MouseLeftButtonDown="HueDown" MouseMove="HueMove" MouseLeftButtonUp="ReleaseMouse">
            <Border CornerRadius="7">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FF0000" Offset="0" />
                        <GradientStop Color="#FFFF00" Offset="0.1667" />
                        <GradientStop Color="#00FF00" Offset="0.3333" />
                        <GradientStop Color="#00FFFF" Offset="0.5" />
                        <GradientStop Color="#0000FF" Offset="0.6667" />
                        <GradientStop Color="#FF00FF" Offset="0.8333" />
                        <GradientStop Color="#FF0000" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Canvas IsHitTestVisible="False">
                <Ellipse x:Name="HueThumb" Width="18" Height="18" Canvas.Top="-2" Stroke="White" StrokeThickness="2">
                    <Ellipse.Effect>
                        <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.6" />
                    </Ellipse.Effect>
                </Ellipse>
            </Canvas>
        </Grid>
        <DockPanel Margin="0,14,0,0">
            <Ellipse x:Name="Preview" DockPanel.Dock="Left" Width="30" Height="30" Margin="0,0,10,0" Stroke="#40FFFFFF" StrokeThickness="1" />
            <TextBox x:Name="HexBox" MaxLength="7" VerticalContentAlignment="Center" FontFamily="Consolas"
                     AutomationProperties.Name="Color code" LostKeyboardFocus="HexCommitted" KeyDown="HexKey" />
        </DockPanel>
    </StackPanel>
</UserControl>
