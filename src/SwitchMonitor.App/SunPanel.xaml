<Window x:Class="SwitchMonitor.App.SunPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SwitchMonitor.App.ViewModels"
        xmlns:app="clr-namespace:SwitchMonitor.App"
        Title="SwitchMonitor brightness" Width="400" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" ShowActivated="True"
        Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <!-- Status dot: green for the display + and - act on (every display when linked), gray for the others -->
        <Style x:Key="SunDot" TargetType="Ellipse">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Fill" Value="#5A5A5A" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLit}" Value="True">
                    <Setter Property="Fill" Value="#4CD97B" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Circled M: filled for the Windows main display; click another one to make it the main display -->
        <Style x:Key="MainMark" TargetType="Button">
            <Setter Property="Width" Value="17" />
            <Setter Property="Height" Value="17" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Ellipse x:Name="Ring" Stroke="{StaticResource FaintBrush}" StrokeThickness="1.2" Fill="Transparent" />
                            <TextBlock x:Name="Letter" Text="M" FontSize="8.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{StaticResource FaintBrush}" />
                            <!-- Preferred main display: a small star on the M -->
                            <TextBlock x:Name="Star" Text="&#xE735;" FontFamily="Segoe MDL2 Assets" FontSize="7.5" Foreground="#FFD166"
                                       HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-5,0" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsPreferred}" Value="True">
                                <Setter TargetName="Star" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsMain}" Value="True">
                                <Setter TargetName="Ring" Property="Fill" Value="{StaticResource TextBrush}" />
                                <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource TextBrush}" />
                                <Setter TargetName="Letter" Property="Foreground" Value="{StaticResource PillOnTextBrush}" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource TextBrush}" />
                                <Setter TargetName="Letter" Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsMain}" Value="True" />
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Letter" Property="Foreground" Value="{StaticResource PillOnTextBrush}" />
                            </MultiDataTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- The value: the typed digits glow in the accent while a number is being typed -->
        <Style x:Key="SunValue" TargetType="TextBlock" BasedOn="{StaticResource Figure}">
            <Setter Property="Width" Value="48" />
            <Setter Property="TextAlignment" Value="Right" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTyping}" Value="True">
                    <Setter Property="Foreground" Value="#4CD97B" />
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#4CD97B" BlurRadius="12" ShadowDepth="0" Opacity="0.8" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- The sun panel: opens above the tray, closes when clicked outside or after a few seconds without use -->
    <Border x:Name="Card" Margin="8" CornerRadius="16" Background="{DynamicResource BackdropBrush}" BorderBrush="#30FFFFFF" BorderThickness="1">
        <Border.RenderTransform>
            <TranslateTransform x:Name="Slide" />
        </Border.RenderTransform>
        <Grid>
        <!-- The window's look (Settings > Appearance): its ground, the soft corner light and the pointer light -->
        <Rectangle x:Name="GlowRect" Fill="{DynamicResource GlowBrush}" IsHitTestVisible="False" RadiusX="15" RadiusY="15" />
        <Rectangle x:Name="PointerLight" IsHitTestVisible="False" Opacity="0" RadiusX="15" RadiusY="15">
            <Rectangle.Fill>
                <RadialGradientBrush x:Name="PointerLightBrush" MappingMode="Absolute" RadiusX="130" RadiusY="130" Center="0,0" GradientOrigin="0,0">
                    <GradientStop Color="#14FFFFFF" Offset="0" />
                    <GradientStop Color="#08FFFFFF" Offset="0.5" />
                    <GradientStop Color="#00FFFFFF" Offset="1" />
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <StackPanel Margin="14,12,14,14">
            <!-- Heading: sun, title, chain, open the window -->
            <DockPanel Margin="4,0,0,10">
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE713;" FontSize="13" Width="30" Height="30" Focusable="False" VerticalAlignment="Center"
                        Command="{Binding OpenWindowCommand}" ToolTip="Open SwitchMonitor" AutomationProperties.Name="Open SwitchMonitor" />
                <ToggleButton DockPanel.Dock="Right" Style="{StaticResource IconToggle}" Content="&#xE71B;" FontSize="12" Width="30" Height="30" Margin="0,0,2,0" Focusable="False" VerticalAlignment="Center"
                              IsChecked="{Binding Linked, Mode=TwoWay}" ToolTip="{Binding LinkToolTip}" AutomationProperties.Name="Link brightness"
                              Visibility="{Binding HasSeveral, Converter={StaticResource BoolToVisibility}}" />
                <Border Style="{StaticResource IconTile}" Width="34" Height="34" CornerRadius="11" Margin="0,0,10,0">
                    <TextBlock Text="&#xE706;" Style="{StaticResource Glyph}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Brightness" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
            </DockPanel>

            <TextBlock Text="No display with brightness control." Style="{StaticResource Hint}" Margin="4,0,0,8"
                       Visibility="{Binding HasRows, Converter={StaticResource InverseBoolToVisibility}}" />

            <Grid x:Name="Rows">
                <!-- The highlight behind the selected display; it glides to the row the pointer or * selects -->
                <Border x:Name="Highlight" CornerRadius="12" Background="{StaticResource RaisedBrush}" VerticalAlignment="Top"
                        HorizontalAlignment="Stretch" Height="0" IsHitTestVisible="False" Opacity="0">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="HighlightShift" />
                    </Border.RenderTransform>
                </Border>

                <!-- Independent: one row per display; OFF rows for displays Windows is not using -->
                <ItemsControl x:Name="RowList" ItemsSource="{Binding Rows}"
                              Visibility="{Binding Unlinked, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:SunRow}">
                            <Border x:Name="RowBox" Background="Transparent" Padding="10,8" MouseWheel="RowWheel" MouseEnter="RowHover"
                                    MouseLeftButtonDown="RowClick" Tag="{Binding}">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding ValueText}" Style="{StaticResource SunValue}" VerticalAlignment="Center" />
                                        <Button DockPanel.Dock="Right" Style="{StaticResource MainMark}" PreviewMouseLeftButtonDown="MainMarkDown" PreviewMouseLeftButtonUp="MainMarkUp" MouseRightButtonUp="MainMarkRightClick" Margin="0,0,10,0"
                                                IsEnabled="{Binding CanBeMain}" ToolTip="{Binding MainToolTip}" ToolTipService.ShowOnDisabled="True"
                                                Visibility="{Binding IsOn, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Main display" />
                                        <Ellipse Style="{StaticResource SunDot}" />
                                        <!-- The display icon; on a monitor with inputs it is a button that opens them -->
                                        <Button x:Name="InputsButton" Click="InputsClick" MouseEnter="MonitorIconEnter" Focusable="False" Margin="-4,0,6,0" Padding="0"
                                                IsHitTestVisible="{Binding HasInputs}" ToolTip="Inputs" AutomationProperties.Name="Inputs">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <!-- Exactly square (1:1): a fixed side, the icon centered, whatever the DPI -->
                                                    <Border x:Name="Box" CornerRadius="7" Width="26" Height="26" Background="Transparent"
                                                            BorderBrush="Transparent" BorderThickness="1">
                                                        <TextBlock x:Name="Icon" Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontSize="13"
                                                                   Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <!-- A monitor with inputs: drawn as a small button (a laptop keeps a plain icon) -->
                                                        <DataTrigger Binding="{Binding HasInputs}" Value="True">
                                                            <Setter TargetName="Box" Property="Background" Value="#14FFFFFF" />
                                                            <Setter TargetName="Box" Property="BorderBrush" Value="#26FFFFFF" />
                                                            <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource TextBrush}" />
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Box" Property="Background" Value="#2AFFFFFF" />
                                                            <Setter TargetName="Box" Property="BorderBrush" Value="#40FFFFFF" />
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="Box" Property="Background" Value="#38FFFFFF" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <TextBlock x:Name="RowName" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <Grid x:Name="RowSliderBox" Margin="18,6,0,0">
                                        <Slider x:Name="RowSlider" Minimum="0" Maximum="100" Value="{Binding Level, Mode=TwoWay}" IsEnabled="{Binding IsReady}"
                                                Focusable="False" AutomationProperties.Name="{Binding Name}" />
                                        <!-- Brightness not read yet: a placeholder bar where the slider goes (same height) -->
                                        <Border x:Name="RowBone" Style="{StaticResource Bone}" Height="6" CornerRadius="3" VerticalAlignment="Center" Visibility="Collapsed" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding HasInputs}" Value="True">
                                    <Setter TargetName="InputsButton" Property="Cursor" Value="Hand" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasInputs}" Value="False">
                                    <Setter TargetName="InputsButton" Property="ToolTip" Value="{x:Null}" />
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsReady}" Value="False" />
                                        <Condition Binding="{Binding IsOff}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="RowSlider" Property="Visibility" Value="Hidden" />
                                    <Setter TargetName="RowBone" Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                                <DataTrigger Binding="{Binding IsOff}" Value="True">
                                    <Setter TargetName="RowSliderBox" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="RowName" Property="Foreground" Value="{StaticResource FaintBrush}" />
                                    <Setter TargetName="RowBox" Property="Padding" Value="10,5" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Linked: the names of every display (green), one shared slider -->
                <Border x:Name="LinkedBox" Padding="10,8" Background="{StaticResource RaisedBrush}" CornerRadius="12"
                        Visibility="{Binding Linked, Converter={StaticResource BoolToVisibility}}"
                        DataContext="{Binding}" MouseWheel="LinkedWheel">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" DataContext="{Binding LeadRow}" Text="{Binding ValueText}" Style="{StaticResource SunValue}"
                                       VerticalAlignment="Top" />
                            <ItemsControl ItemsSource="{Binding LinkedRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:SunRow}">
                                        <DockPanel Margin="0,1,0,3">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource MainMark}" PreviewMouseLeftButtonDown="MainMarkDown" PreviewMouseLeftButtonUp="MainMarkUp" MouseRightButtonUp="MainMarkRightClick" Margin="0,0,10,0"
                                                    IsEnabled="{Binding CanBeMain}" ToolTip="{Binding MainToolTip}" ToolTipService.ShowOnDisabled="True"
                                                    AutomationProperties.Name="Main display" />
                                            <Ellipse Style="{StaticResource SunDot}" />
                                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontSize="13" Margin="0,1,8,0"
                                                       Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                        <Slider DataContext="{Binding LeadRow}" Minimum="0" Maximum="100" Value="{Binding Level, Mode=TwoWay}" IsEnabled="{Binding IsReady}"
                                Margin="18,6,0,0" Focusable="False" AutomationProperties.Name="Linked brightness" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Profiles of the selected display, as small icons (name on hover). Clicking Custom while it is in use opens
                 the picture modes to the left of the panel. -->
            <Border Height="1" Background="{StaticResource LineBrush}" Margin="4,12,4,10" />
            <ItemsControl x:Name="ProfileList" ItemsSource="{Binding Scenes}" Margin="4,0,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:SceneViewModel}">
                        <Button x:Name="Pill" Click="ProfileClick" MouseEnter="ProfileEnter" MouseLeave="ProfileLeave" Margin="0,0,6,4" Width="28" Height="28" Padding="0" Focusable="False"
                                ToolTip="{Binding Label}" AutomationProperties.Name="{Binding Name}" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <!-- Fixed square: the ring stays a circle -->
                                    <Grid x:Name="Root" Width="28" Height="28" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                                        <Grid.RenderTransform>
                                            <TransformGroup>
                                                <ScaleTransform />
                                                <ScaleTransform />
                                            </TransformGroup>
                                        </Grid.RenderTransform>
                                        <Ellipse x:Name="Ring" Width="28" Height="28" Stroke="{Binding EdgeBrush}" StrokeThickness="1.5" Opacity="0" />
                                        <app:ProfileBadge x:Name="Badge" Width="22" Height="22" CornerRadius="11" GlyphSize="12"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          Fill="{Binding ColorBrush}" Glyph="{Binding SolidMark.Text}" GlyphFont="{Binding SolidMark.Font}"
                                                          GlyphWeight="{Binding SolidMark.Weight}" Image="{Binding IconImage}"
                                                          Opacity="0.85" />
                                        <!-- Hover: a soft light over the badge (its own layer, so it never fights the active state) -->
                                        <Ellipse x:Name="Light" Width="22" Height="22" Fill="{StaticResource OverlayBrush}" Opacity="0"
                                                 IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <!-- Changed by hand since it was applied ("custom"; Save? is on the main window) -->
                                        <Ellipse x:Name="Modified" Width="8" Height="8" Fill="White" Stroke="#FF1C1C1C" StrokeThickness="1.5"
                                                 HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="Collapsed" />
                                    </Grid>
                                    <!-- Same motion as the window's buttons: ease-in-out, 200 ms; hover lights and grows, press shrinks,
                                         the active profile fades its ring and full color in, disabled dims -->
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="Light" Storyboard.TargetProperty="Opacity" To="0.16"
                                                                         Duration="0:0:0.2" EasingFunction="{StaticResource EaseInOut}" />
                                                        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(ScaleTransform.ScaleX)" To="1.08"
                                                                         Duration="0:0:0.2" EasingFunction="{StaticResource EaseInOut}" />
                                                        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(ScaleTransform.ScaleY)" To="1.08"
                                                                         Duration="0:0:0.2" EasingFunction="{StaticResource EaseInOut}" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="Light" Storyboard.TargetProperty="Opacity" To="0"
                                                                         Duration="0:0:0.2" EasingFunction="{StaticResource EaseInOut}" />
                                                        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(ScaleTransform.ScaleX)" To="1"
                                                                         Duration="0:0:0.2" EasingFunction="{StaticResource EaseInOut}" />
                                                        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(ScaleTransform.ScaleY)" To="1"
                                                                         Duration="0:0:0.2" EasingFunction="{StaticResource EaseInOut}" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="0.92"
                                                                         Duration="0:0:0.1" EasingFunction="{StaticResource EaseInOut}" />
                                                        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" To="0.92"
                                                                         Duration="0:0:0.1" EasingFunction="{StaticResource EaseInOut}" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="1"
                                                                         Duration="0:0:0.15" EasingFunction="{StaticResource EaseInOut}" />
                                                        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" To="1"
                                                                         Duration="0:0:0.15" EasingFunction="{StaticResource EaseInOut}" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity" To="1"
                                                                         Duration="0:0:0.2" EasingFunction="{StaticResource EaseInOut}" />
                                                        <DoubleAnimation Storyboard.TargetName="Badge" Storyboard.TargetProperty="Opacity" To="1"
                                                                         Duration="0:0:0.2" EasingFunction="{StaticResource EaseInOut}" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity" To="0"
                                                                         Duration="0:0:0.2" EasingFunction="{StaticResource EaseInOut}" />
                                                        <DoubleAnimation Storyboard.TargetName="Badge" Storyboard.TargetProperty="Opacity" To="0.85"
                                                                         Duration="0:0:0.2" EasingFunction="{StaticResource EaseInOut}" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsModified}" Value="True">
                                            <Setter TargetName="Modified" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsShown}" Value="False">
                                <Setter TargetName="Pill" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Picture modes of the selected display, beside the panel (Custom only). A pick is sent 1 second later. -->
            <Popup x:Name="ModesPopup" PlacementTarget="{Binding ElementName=Card}" Placement="Custom" AllowsTransparency="True"
                   StaysOpen="True" Focusable="False">
                <Border x:Name="ModesCard" CornerRadius="16" Background="{DynamicResource BackdropBrush}" BorderBrush="#30FFFFFF"
                        BorderThickness="1" Padding="8,10,8,8" Width="190" MouseEnter="ModesEnter">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="ModesSlide" />
                    </Border.RenderTransform>
                    <StackPanel>
                        <DockPanel Margin="8,0,4,8">
                            <StackPanel>
                                <TextBlock Text="Picture mode" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding ModesDisplayName}" Style="{StaticResource Hint}" FontSize="11" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding ModeItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ModeItem}">
                                    <Button Click="ModeClick" Focusable="False" Cursor="Hand" Margin="0,1" Padding="10,6"
                                            Template="{StaticResource ItemButtonTemplate}" app:ButtonMotion.IsSelected="{Binding IsPicked}"
                                            HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding Label}">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="&#xE73E;" Style="{StaticResource Glyph}"
                                                       FontSize="11" VerticalAlignment="Center"
                                                       Visibility="{Binding IsPicked, Converter={StaticResource BoolToVisibility}}" />
                                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontSize="13" Width="22"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding HasGlyph, Converter={StaticResource BoolToVisibility}}" />
                                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Popup>

            <!-- Inputs of one monitor (its icon was clicked), beside the panel like the picture modes: click one to switch;
                 the round switch keeps it in Next input -->
            <Popup x:Name="InputsPopup" PlacementTarget="{Binding ElementName=Card}" Placement="Custom" AllowsTransparency="True" StaysOpen="True" Focusable="False">
                <Border x:Name="InputsCard" CornerRadius="16" Background="{DynamicResource BackdropBrush}" BorderBrush="#30FFFFFF"
                        BorderThickness="1" Padding="8,10,8,8" Width="210" MouseEnter="ModesEnter">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="InputsSlide" />
                    </Border.RenderTransform>
                    <StackPanel>
                        <DockPanel Margin="8,0,4,8">
                            <StackPanel>
                                <TextBlock Text="Inputs" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Name}" Style="{StaticResource Hint}" FontSize="11" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Inputs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:InputViewModel}">
                                    <Grid Margin="0,1">
                                        <Button Command="{Binding SelectCommand}" Focusable="False" Cursor="Hand" AutomationProperties.Name="{Binding Label}"
                                                ToolTip="Switch to this input" Padding="36,7,10,7"
                                                Template="{StaticResource ItemButtonTemplate}" app:ButtonMotion.IsSelected="{Binding IsCurrent}"
                                                HorizontalContentAlignment="Stretch">
                                            <DockPanel>
                                                <Path Data="{Binding ConnectorShape}" Width="22" Height="14" Stretch="Uniform" Margin="0,0,10,0"
                                                      Stroke="{StaticResource TextBrush}" StrokeThickness="1.4" StrokeLineJoin="Round"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DockPanel>
                                        </Button>
                                        <ToggleButton Style="{StaticResource CycleToggle}" IsChecked="{Binding InCycle, Mode=TwoWay}" Focusable="False"
                                                      HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0"
                                                      ToolTip="Next input stops here (on) or skips it (off)" AutomationProperties.Name="Next input stops here">
                                            <ToggleButton.LayoutTransform>
                                                <ScaleTransform ScaleX="0.75" ScaleY="0.75" />
                                            </ToggleButton.LayoutTransform>
                                        </ToggleButton>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding NextInputText}" Style="{StaticResource Hint}" FontSize="11"
                                   Margin="8,6,4,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Popup>
        </StackPanel>
        </Grid>
    </Border>
</Window>
