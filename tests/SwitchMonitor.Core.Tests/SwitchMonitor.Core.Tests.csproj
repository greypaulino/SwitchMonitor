<Project Sdk="Microsoft.NET.Sdk">

  <!-- Hardware-free tests. A small built-in runner keeps the repository free of third-party packages. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SwitchMonitor.Core.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SwitchMonitor.Core\SwitchMonitor.Core.csproj" />
  </ItemGroup>

</Project>
