<Window x:Class="SwitchMonitor.Wpf.LegacyImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import AutoHotkey settings" Width="540" Height="510" MinWidth="500" MinHeight="380"
        WindowStartupLocation="CenterOwner" Background="#1E1E1E" Foreground="White"
        FontFamily="Segoe UI" ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#363636" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="15,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#505050" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="27,24,27,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Import AutoHotkey settings" FontSize="22" FontWeight="SemiBold"
                   HorizontalAlignment="Center" Margin="0,0,0,13" />
        <TextBlock Grid.Row="1" Text="Review the values that will replace the WPF profile."
                   Foreground="#B7B7B7" HorizontalAlignment="Center" Margin="0,0,0,18" />
        <Border Grid.Row="2" Background="#252525" CornerRadius="8" Padding="15">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="SummaryText" FontFamily="Consolas" FontSize="12"
                           TextWrapping="Wrap" Foreground="#D4D4D4" />
            </ScrollViewer>
        </Border>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,19,0,0">
            <Button Content="Cancel" Width="140" Margin="0,0,15,0" Click="Cancel_Click" />
            <Button Content="Import" Width="140" Background="#3C3C3C" Click="Import_Click" />
        </StackPanel>
    </Grid>
</Window>
