<Window x:Class="SwitchMonitor.Wpf.BrightnessFlyout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Brightness" Width="400" Height="124" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" Background="#1E1E1E" Foreground="White"
        FontFamily="Segoe UI" Deactivated="Flyout_Deactivated"
        MouseEnter="Flyout_MouseEnter" MouseLeave="Flyout_MouseLeave"
        PreviewMouseWheel="Flyout_MouseWheel">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#D0D0D0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <BooleanToVisibilityConverter x:Key="BoolVisibility" />
    </Window.Resources>
    <Border x:Name="Card" Background="#1E1E1E" BorderBrush="#343434" BorderThickness="1"
            CornerRadius="12" Padding="15,12,15,16">
        <Border.RenderTransform><TranslateTransform x:Name="CardTransform" Y="0" /></Border.RenderTransform>
        <StackPanel>
            <Grid Margin="0,0,0,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Brightness" Foreground="#B7B7B7" FontSize="12" VerticalAlignment="Center" />
                <Button x:Name="LinkButton" Grid.Column="1" Width="27" Height="27" Click="Link_Click"
                        ToolTip="Link monitor brightness" Margin="0,0,4,0">
                    <TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="17" />
                </Button>
                <Button Grid.Column="2" Width="27" Height="27" Click="Settings_Click" ToolTip="Open Settings">
                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="17" />
                </Button>
            </Grid>
            <ItemsControl x:Name="BrightnessRows">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,8">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,7" MouseLeftButtonDown="Row_Click">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="56" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,8,0"
                                         Visibility="{Binding ShowDot, Converter={StaticResource BoolVisibility}}">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#737373" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Active}" Value="True">
                                                    <Setter Property="Fill" Value="#4EC97B" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" TextWrapping="Wrap"
                                           VerticalAlignment="Center" FontSize="12" />
                                <TextBlock Grid.Column="2" Text="{Binding Value, StringFormat={}{0:0}%}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" />
                            </Grid>
                            <Slider Grid.Row="1" Minimum="0" Maximum="100" Height="23"
                                    IsEnabled="{Binding Supported}"
                                    Value="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    ValueChanged="Slider_ValueChanged" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</Window>
