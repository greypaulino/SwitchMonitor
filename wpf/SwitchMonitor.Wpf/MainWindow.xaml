<Window x:Class="SwitchMonitor.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SwitchMonitor — WPF preview" Width="510" Height="650"
        MinWidth="440" MinHeight="500" Background="#1E1E1E" Foreground="White"
        FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#363636" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#505050" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="White" /></Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#D4D4D4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <BooleanToVisibilityConverter x:Key="BoolVisibility" />
    </Window.Resources>

    <Grid Margin="26,22,26,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="SwitchMonitor" FontSize="25" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Text="Native Windows monitor control preview" Foreground="#B7B7B7"
                       HorizontalAlignment="Center" Margin="0,7,0,0" />
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,0,0,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Monitor:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
            <ComboBox x:Name="MonitorChoice" Grid.Column="1" Height="34" Background="#2D2D2D"
                      Foreground="White" BorderThickness="0" SelectionChanged="MonitorChoice_SelectionChanged" />
            <Button Grid.Column="2" Content="Refresh" Margin="12,0,0,0" Click="Refresh_Click" />
        </Grid>
        <Border Grid.Row="2" Height="1" Background="#3C3C3C" Margin="0,0,0,18" />
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="INPUTS" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,14" />
                <ItemsControl x:Name="PortList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="112" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                <CheckBox Grid.Column="1" Content="Next" IsChecked="{Binding Connected}"
                                          Click="Connected_Click" Margin="0,0,16,0" />
                                <Button Grid.Column="2" Content="Switch" Tag="{Binding Code}"
                                        Click="Switch_Click" IsEnabled="{Binding CanSwitch}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="InputHint" TextWrapping="Wrap" Foreground="#B7B7B7"
                           FontSize="12" Margin="8,5,8,20" />
                <Button x:Name="NextButton" Content="Next marked input · Ctrl+Alt+M"
                        HorizontalAlignment="Center" Click="Next_Click" Margin="0,0,0,22" />
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="4" BorderBrush="#3C3C3C" BorderThickness="0,1,0,0" Padding="0,18,0,14">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="BRIGHTNESS" FontWeight="SemiBold" />
                    <CheckBox x:Name="LinkBrightness" Grid.Column="1" Content="Link monitors"
                              Click="LinkBrightness_Click" />
                </Grid>
                <ItemsControl x:Name="BrightnessRows">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,8" MouseLeftButtonDown="BrightnessRow_Click">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0"
                                             Visibility="{Binding ShowDot, Converter={StaticResource BoolVisibility}}">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#777777" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Active}" Value="True">
                                                        <Setter Property="Fill" Value="#4EC97B" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding Value, StringFormat={}{0:0}%}"
                                               VerticalAlignment="Center" />
                                </Grid>
                                <Slider Grid.Row="1" Minimum="0" Maximum="100" IsEnabled="{Binding Supported}"
                                        Value="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        ValueChanged="BrightnessRowSlider_ValueChanged" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Ctrl+Alt+− / Ctrl+Alt++ adjusts brightness · Ctrl+Alt+* selects a monitor" Foreground="#B7B7B7"
                           FontSize="12" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
        <TextBlock x:Name="StatusText" Grid.Row="5" Foreground="#B7B7B7" TextWrapping="Wrap"
                   HorizontalAlignment="Center" TextAlignment="Center" Margin="8,12,8,0" />
    </Grid>
</Window>
