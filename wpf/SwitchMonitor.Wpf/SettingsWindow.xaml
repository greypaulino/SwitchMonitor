<Window x:Class="SwitchMonitor.Wpf.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SwitchMonitor Settings" Width="560" Height="930" MinWidth="520" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="#1E1E1E" Foreground="White"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#2D2D2D" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#454545" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="White" /></Style>
        <Style TargetType="CheckBox"><Setter Property="VerticalAlignment" Value="Center" /></Style>
    </Window.Resources>
    <Grid Margin="40,25,40,21">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="Settings" FontSize="28" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,0,0,16" />
                <TextBlock Text="Choose inputs and keyboard shortcuts." Foreground="#B7B7B7"
                           HorizontalAlignment="Center" Margin="0,0,0,27" />
                <Grid HorizontalAlignment="Center" Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="210" />
                        <ColumnDefinition Width="90" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Monitor:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <ComboBox x:Name="MonitorChoice" Grid.Column="1" Height="32" Background="#2D2D2D"
                              Foreground="White" BorderThickness="0" SelectionChanged="MonitorChoice_SelectionChanged" />
                    <Button Grid.Column="2" Content="Detect" Margin="9,0,0,0" Click="Detect_Click" />
                </Grid>
                <Border Height="1" Background="#3C3C3C" Margin="0,0,0,18" />
                <TextBlock Text="INPUT SHORTCUTS" FontSize="14" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,0,0,7" />
                <TextBlock Text="Check the inputs to include in Next input." FontSize="12"
                           Foreground="#B7B7B7" HorizontalAlignment="Center" Margin="0,0,0,16" />
                <ItemsControl x:Name="InputRows" Margin="0,0,0,13">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="172" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding Connected, Mode=TwoWay}" Click="Connected_Click" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" />
                                <Button Grid.Column="2" Content="{Binding Shortcut}" Tag="{Binding}"
                                        Click="PortShortcut_Click" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Height="1" Background="#3C3C3C" Margin="0,0,0,17" />
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Next input" VerticalAlignment="Center" Margin="28,0,0,0" />
                    <Button x:Name="CycleShortcut" Grid.Column="1" Tag="cycle" Click="GlobalShortcut_Click"
                            ToolTip="Switches to the next checked input on the selected monitor." />
                </Grid>
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Open Settings" VerticalAlignment="Center" Margin="28,0,0,0" />
                    <Button x:Name="SettingsShortcut" Grid.Column="1" Tag="settings" Click="GlobalShortcut_Click"
                            ToolTip="Opens Settings for the selected monitor." />
                </Grid>
                <Border Height="1" Background="#3C3C3C" Margin="0,0,0,18" />
                <TextBlock Text="BRIGHTNESS CONTROL" FontSize="14" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,0,0,15" />
                <Grid Margin="0,0,0,11">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Decrease brightness" VerticalAlignment="Center" Margin="28,0,0,0" />
                    <Button x:Name="DownShortcut" Grid.Column="1" Tag="brightnessDown" Click="GlobalShortcut_Click"
                            ToolTip="Tap for 1 point; hold to accelerate." />
                </Grid>
                <Grid Margin="0,0,0,11">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Increase brightness" VerticalAlignment="Center" Margin="28,0,0,0" />
                    <Button x:Name="UpShortcut" Grid.Column="1" Tag="brightnessUp" Click="GlobalShortcut_Click"
                            ToolTip="Tap for 1 point; hold to accelerate." />
                </Grid>
                <Grid Margin="0,0,0,11">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Next monitor" VerticalAlignment="Center" Margin="28,0,0,0" />
                    <Button x:Name="NextMonitorShortcut" Grid.Column="1" Tag="brightnessNext" Click="GlobalShortcut_Click"
                            ToolTip="Selects the next monitor for brightness shortcuts." />
                </Grid>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Link monitor brightness" VerticalAlignment="Center" Margin="28,0,0,0" />
                    <Button x:Name="LinkButton" Grid.Column="1" Click="Link_Click"
                            ToolTip="Applies the same percentage to all detected monitors." />
                </Grid>
                <Border Height="1" Background="#3C3C3C" Margin="0,0,0,17" />
                <UniformGrid Columns="2" Margin="72,0,72,0">
                    <Button Content="Check connection" Click="Check_Click" Margin="0,0,6,8" />
                    <Button Content="Export diagnostics" Click="Export_Click" Margin="6,0,0,8" />
                    <Button Content="Back up settings" Click="Backup_Click" Margin="0,0,6,8" />
                    <Button Content="Restore settings" Click="Restore_Click" Margin="6,0,0,8" />
                </UniformGrid>
                <Button Content="Import AutoHotkey settings" Width="300" HorizontalAlignment="Center"
                        Margin="0,3,0,0" Click="ImportLegacy_Click"
                        ToolTip="Preview and copy settings from the AutoHotkey INI into this WPF profile." />
                <Border Height="1" Background="#3C3C3C" Margin="0,22,0,16" />
                <CheckBox x:Name="AutomaticUpdates" Content="Check GitHub for updates automatically"
                          HorizontalAlignment="Center" Click="AutomaticUpdates_Click"
                          ToolTip="Checks GitHub at startup and every six hours. Manual checks remain available." />
                <TextBlock x:Name="StatusText" Foreground="#B7B7B7" TextAlignment="Center"
                           TextWrapping="Wrap" Margin="0,10,0,17" MinHeight="24" />
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" BorderBrush="#3C3C3C" BorderThickness="0,1,0,0" Padding="0,14,0,0">
            <Grid HorizontalAlignment="Center">
                <Button x:Name="CloseButton" Content="Close" Width="150" Click="Close_Click" />
                <StackPanel x:Name="DirtyButtons" Orientation="Horizontal" Visibility="Collapsed">
                    <Button Content="Cancel" Width="150" Margin="0,0,16,0" Click="Close_Click" />
                    <Button Content="Save" Width="150" Background="#3C3C3C" Click="Save_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
